# Application
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
API_URL=http://localhost:3001

# Frontend (Vite)
VITE_API_URL=http://localhost:3001

# Supabase — DATABASE_URL stores share metadata. Service role key is required for Storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=securedrop
DATABASE_URL=

# Email (SMTP) — leave blank to write messages to server/data/outbox instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SecureDrop <noreply@localhost>

# Security
MAX_UPLOAD_BYTES=52428800
CLEANUP_INTERVAL_MS=60000
OTP_TTL_MS=600000
DOWNLOAD_GRANT_TTL_MS=120000
PBKDF2_ITERATIONS=210000
